--- a/llvm/include/llvm/Analysis/VecFuncs.def
+++ b/llvm/include/llvm/Analysis/VecFuncs.def
@@ Add to TLI_DEFINE_LIBMVEC_X86_VECFUNCS, alongside the existing entries @@
+// AVX (c-class, 256-bit) rows for glibc >= 2.35 functions VecFuncs.def
+// does not yet list. Verified against glibc 2.39 (Ubuntu 24.04)
+// libmvec.so.1 via `nm -D`; see harness/gap_analysis.md for the method.
+// SSE2 (b) / AVX2 (d) rows deliberately omitted: not present in this
+// glibc's exported symbol table for these functions, unlike the
+// original 12 (cos/exp/log/pow/sin/tan), and not assumed without
+// separate verification against upstream glibc's own ABI documentation.
+TLI_DEFINE_VECFUNC("acos", "_ZGVcN4v_acos", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("acosf", "_ZGVcN8v_acosf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("asin", "_ZGVcN4v_asin", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("asinf", "_ZGVcN8v_asinf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("atan", "_ZGVcN4v_atan", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("atanf", "_ZGVcN8v_atanf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("atan2", "_ZGVcN4vv_atan2", FIXED(4), "_ZGV_LLVM_N4vv")
+TLI_DEFINE_VECFUNC("atan2f", "_ZGVcN8vv_atan2f", FIXED(8), "_ZGV_LLVM_N8vv")
+TLI_DEFINE_VECFUNC("cosh", "_ZGVcN4v_cosh", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("coshf", "_ZGVcN8v_coshf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("sinh", "_ZGVcN4v_sinh", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("sinhf", "_ZGVcN8v_sinhf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("tanh", "_ZGVcN4v_tanh", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("tanhf", "_ZGVcN8v_tanhf", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("exp10", "_ZGVcN4v_exp10", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("exp10f", "_ZGVcN8v_exp10f", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("exp2", "_ZGVcN4v_exp2", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("exp2f", "_ZGVcN8v_exp2f", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("log10", "_ZGVcN4v_log10", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("log10f", "_ZGVcN8v_log10f", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("log2", "_ZGVcN4v_log2", FIXED(4), "_ZGV_LLVM_N4v")
+TLI_DEFINE_VECFUNC("log2f", "_ZGVcN8v_log2f", FIXED(8), "_ZGV_LLVM_N8v")
+TLI_DEFINE_VECFUNC("hypot", "_ZGVcN4vv_hypot", FIXED(4), "_ZGV_LLVM_N4vv")
+TLI_DEFINE_VECFUNC("hypotf", "_ZGVcN8vv_hypotf", FIXED(8), "_ZGV_LLVM_N8vv")
+
+// sincos/sincosf deliberately NOT included: glibc's x86 export
+// (_ZGVcN4vvv_sincos) uses a three-"v" mangling that doesn't match the
